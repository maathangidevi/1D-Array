import java.util.*;

public class demo {
    public static void main(String[] args) {

        int[] arr = {1, 1, 2, 3, 3};
        boolean[] visited = new boolean[arr.length];

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] != -1) {

                int count = 1;

                for (int j = i + 1; j < arr.length; j++) {
                    if (arr[i] == arr[j]) {
                        count++;
                        visited[j] = true;
                        arr[j] = -1;
                    }
                }

                System.out.println("Freq of " + arr[i] + " = " + count);
            }
        }
    }
}

