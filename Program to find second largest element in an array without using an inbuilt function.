import java.util.*;

public class demo {
    public static void main(String[] args) {

        int[] arr = {3, 2, 7};
        int largest = 0;
        int seclargest = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > largest) {
                seclargest = largest;
                largest = arr[i];
            }
            else if (arr[i] > seclargest && arr[i] != largest) {
                seclargest = arr[i];
            }
        }

        System.out.println(seclargest);
    }
}

