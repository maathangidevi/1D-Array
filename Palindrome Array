import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        boolean palindrome = true;

        for (int i = 0; i < n / 2; i++) {
            if (arr[i] != arr[n - 1 - i]) {
                palindrome = false;
                break;
            }
        }

        if (palindrome) {
            System.out.println("Palindrome Array");
        } else {
            System.out.println("Not a palindrome Array");
        }
    }
}

