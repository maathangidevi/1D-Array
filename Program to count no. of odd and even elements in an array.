import java.util.*;

public class Main {
    public static void main(String[] args) {

        int[] arr = {1, 2, 3, 4, 5};
        int odd = 0;
        int even = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] % 2 == 0) {
                even += i;
            } else {
                odd++;
            }
        }

        System.out.println("oddcount = " + odd);
        System.out.println("evencount = " + even);
    }
}

