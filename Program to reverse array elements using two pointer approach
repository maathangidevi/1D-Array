import java.util.*;

public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 20, 30, 40};
        int left = 0;
        int right = arr.length - 1;

        while (left < right) {
            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;

            left++;
            right--;
        }

        System.out.println(Arrays.toString(arr));
    }
}

O/P:
[40, 30, 20, 10]
